# DNS A/AAAA must point to the deployment host, with inbound TCP 80/443 open.
DOMAIN=knowpipe.example.com
# Generate each independently: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Hex avoids reserved characters in the MongoDB connection URI.
MONGO_PASSWORD=replace-with-an-independent-random-hex-password
